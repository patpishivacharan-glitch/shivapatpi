rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'patpi.shivacharan@gmail.com'
      );
    }

    function isStudentParent(studentId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/hindiStudents/$(studentId)).data.parentEmail
          == request.auth.token.email;
    }

    match /hindi-homework/{studentId}/{assignmentId}/{fileName} {
      allow read: if isAdmin() || isStudentParent(studentId);
      allow write: if (isAdmin() || isStudentParent(studentId))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|image/jpeg|image/png'
        );
    }
  }
}
