# EmailJS Configuration
# You need to sign up at https://www.emailjs.com/ and get these values

# Your EmailJS Service ID
REACT_APP_EMAILJS_SERVICE_ID=service_shivapatpi

# Your EmailJS Template ID  
REACT_APP_EMAILJS_TEMPLATE_ID=template_contact

# Your EmailJS Public Key
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your email address (for reference)
REACT_APP_TO_EMAIL=patpi.shivacharan@gmail.com

# Firebase Authentication, Firestore, and Storage (required for Hindi Classes)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
